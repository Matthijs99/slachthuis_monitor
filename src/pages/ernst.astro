---
import Layout from '../layouts/Layout.astro';
import { loadData } from '../lib/data';
import { BASE as base } from '../lib/site';
import { ERNST_TIERS, ERNST_LABELS, ERNST_DESCRIPTIONS } from '../lib/ernst';

const { cases } = loadData();

// Pick one example case per tier — highest case-number with that tier
const examples = ERNST_TIERS.map(n => {
  const matching = cases.filter(c => c.ernst === n).sort((a, b) => b.nr - a.nr);
  return {
    n,
    label: ERNST_LABELS[n],
    description: ERNST_DESCRIPTIONS[n],
    count: matching.length,
    example: matching[0] ?? null,
  };
});
---
<Layout title="Ernstgradering">
  <h1>Ernstgradering</h1>
  <p class="lede">
    Elke bevinding is geclassificeerd op welzijnsimpact in vier tiers. Deze classificatie staat
    los van het boetebedrag — de boete reflecteert het juridisch oordeel van de NVWA, de tier
    reflecteert het effect op het dier.
  </p>

  <ol class="tiers">
    {examples.map(t => (
      <li class={`tier ernst-${t.n}`}>
        <header>
          <span class={`badge ernst-${t.n}`}>{t.n}</span>
          <h2>{t.label}</h2>
          <a class="count" href={`${base}/?ernst=${t.n}`}>
            {t.count} {t.count === 1 ? 'bevinding' : 'bevindingen'} op de kaart &rarr;
          </a>
        </header>
        <p>{t.description}</p>
        {t.example && (
          <blockquote>
            <p>{t.example.samenvatting}</p>
            <footer>— bevinding #{t.example.nr}, {t.example.datum}</footer>
          </blockquote>
        )}
      </li>
    ))}
  </ol>
</Layout>

<style>
  .lede { font-size: 1.05rem; max-width: 70ch; color: var(--c-text-soft); }
  .tiers { list-style: none; padding: 0; margin: 2rem 0 0; }
  .tier { padding: 1rem 1.2rem; border-left: 6px solid var(--c-border-strong); margin-bottom: 1.2rem; background: var(--c-surface); }
  .tier.ernst-1 { border-left-color: var(--c-ernst-1); }
  .tier.ernst-2 { border-left-color: var(--c-ernst-2); }
  .tier.ernst-3 { border-left-color: var(--c-ernst-3); }
  .tier.ernst-4 { border-left-color: var(--c-ernst-4); }
  .tier header { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; }
  .tier h2 { margin: 0; font-size: 1.15rem; }
  .count { margin-left: auto; font-size: 0.85rem; }
  .badge { width: 2rem; height: 2rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; color: white; font-weight: 700; }
  .badge.ernst-1 { background: var(--c-ernst-1); color: #222; }
  .badge.ernst-2 { background: var(--c-ernst-2); }
  .badge.ernst-3 { background: var(--c-ernst-3); }
  .badge.ernst-4 { background: var(--c-ernst-4); }
  blockquote { margin: 0.8rem 0 0; font-style: italic; max-width: 70ch; }
  blockquote footer { font-style: normal; font-size: 0.85rem; color: var(--c-muted-soft); margin-top: 0.3rem; }
</style>
